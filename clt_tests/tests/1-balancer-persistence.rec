––– input –––
printf 'balancer:\n  persistence:\n    enabled: true\n  config:\n    content: |\n      searchd\n      {\n        listen = /var/run/mysqld/mysqld.sock:mysql\n        listen = 9306:mysql\n        listen = 9308:http\n        listen = 9312\n        query_log = /dev/stdout\n        query_log_format = sphinxql\n        pid_file = /var/run/manticore/searchd.pid\n        data_dir = /var/lib/manticore\n        binlog_path = /var/lib/manticore\n        shutdown_timeout = 25s\n      }\n  image:\n    tag: 0.0.0-unstable\nworker:\n  replicaCount: 1\n  image:\n    tag: 0.0.0-unstable\n' >/tmp/clt-values.yaml; cat /tmp/clt-values.yaml
––– output –––
balancer:
  persistence:
    enabled: true
  config:
    content: |
      searchd
      {
        listen = /var/run/mysqld/mysqld.sock:mysql
        listen = 9306:mysql
        listen = 9308:http
        listen = 9312
        query_log = /dev/stdout
        query_log_format = sphinxql
        pid_file = /var/run/manticore/searchd.pid
        data_dir = /var/lib/manticore
        binlog_path = /var/lib/manticore
        shutdown_timeout = 25s
      }
  image:
    tag: 0.0.0-unstable
worker:
  replicaCount: 1
  image:
    tag: 0.0.0-unstable
––– block: ./init/install –––
––– input –––
if kubectl wait --for=condition=Ready pod -l app.kubernetes.io/instance=my-helm --timeout=180s >/dev/null && [[ $(kubectl get pods -l app.kubernetes.io/instance=my-helm --no-headers | wc -l) -eq 2 ]]; then echo "OK"; else echo "Failed waiting until pods were ready"; kubectl get po -o wide || true; false; fi
