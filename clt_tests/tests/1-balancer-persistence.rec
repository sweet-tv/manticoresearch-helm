kubectl exec my-helm-manticoresearch-worker-0 -- mysql -h0 -P9306 -e "CREATE TABLE persistence_source(title text); ALTER CLUSTER manticore_cluster ADD persistence_source; INSERT INTO manticore_cluster:persistence_source (title) VALUES ('survives restart');"; echo $?
