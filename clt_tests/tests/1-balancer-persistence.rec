0
––– input –––
export BALANCER_NAME=$(kubectl get pods -l "app.kubernetes.io/name=manticoresearch,app.kubernetes.io/instance=my-helm,app.kubernetes.io/component=balancer" -o jsonpath="{.items[0].metadata.name}"); if timeout 180 bash -c 'until kubectl exec "$BALANCER_NAME" -- mysql -h0 -P9306 -e "SHOW TABLES" 2>/dev/null | grep -q persistence_source; do sleep 2; done'; then echo "source visible"; else echo "source missing"; false; fi
––– output –––
source visible
––– input –––
kubectl exec "$BALANCER_NAME" -- mysql --skip-table --silent --skip-column-names --raw -h0 -P9306 -e "CREATE TABLE stable_alias type='distributed' agent_persistent='my-helm-manticoresearch-worker-svc:9312:persistence_source[conn=pconn]'; SELECT title FROM stable_alias;"
––– output –––
survives restart
––– input –––
export OLD_BALANCER_UID=$(kubectl get pod "$BALANCER_NAME" -o jsonpath='{.metadata.uid}'); kubectl delete pod "$BALANCER_NAME" --wait=false >/dev/null; if timeout 300 bash -c 'while true; do new_name=$(kubectl get pods -l "app.kubernetes.io/name=manticoresearch,app.kubernetes.io/instance=my-helm,app.kubernetes.io/component=balancer" -o jsonpath="{.items[0].metadata.name}" 2>/dev/null); new_uid=$(kubectl get pod "$new_name" -o jsonpath="{.metadata.uid}" 2>/dev/null); ready=$(kubectl get pod "$new_name" -o jsonpath="{.status.conditions[?(@.type==\"Ready\")].status}" 2>/dev/null); if [[ -n "$new_name" && "$new_uid" != "$OLD_BALANCER_UID" && "$ready" == "True" ]]; then exit 0; fi; sleep 2; done'; then echo "balancer replaced and ready"; else kubectl get pods -o wide; false; fi
––– output –––
balancer replaced and ready
––– input –––
export BALANCER_NAME=$(kubectl get pods -l "app.kubernetes.io/name=manticoresearch,app.kubernetes.io/instance=my-helm,app.kubernetes.io/component=balancer" -o jsonpath="{.items[0].metadata.name}"); kubectl exec "$BALANCER_NAME" -- mysql --skip-table --silent --skip-column-names --raw -h0 -P9306 -e "SHOW CREATE TABLE stable_alias; SELECT title FROM stable_alias;" | grep -E "agent_persistent|survives restart"
––– output –––
stable_alias	CREATE TABLE stable_alias type='distributed' agent_persistent='my-helm-manticoresearch-worker-svc:9312:persistence_source[conn=pconn]'
survives restart
